{
  "$ref": "#/definitions/WorkoutPlan",
  "definitions": {
    "WorkoutPlan": {
      "type": "object",
      "properties": {
        "versao": {
          "type": "number",
          "const": 2
        },
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "unidade_carga": {
          "type": "string",
          "const": "kg"
        },
        "treinos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "nome": {
                "type": "string",
                "minLength": 1
              },
              "dias_semana": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "segunda",
                    "terca",
                    "quarta",
                    "quinta",
                    "sexta",
                    "sabado",
                    "domingo"
                  ]
                }
              },
              "exercicios": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "nome": {
                      "type": "string",
                      "minLength": 1
                    },
                    "equipamento": {
                      "type": "string",
                      "enum": [
                        "barra",
                        "halteres",
                        "maquina",
                        "cabo",
                        "kettlebell",
                        "elastico",
                        "peso_corporal",
                        "outro"
                      ]
                    },
                    "forma_carga": {
                      "type": "string",
                      "enum": [
                        "total",
                        "por_lado",
                        "por_halter",
                        "peso_corporal",
                        "assistencia"
                      ],
                      "description": "Como a carga é registrada. por_halter: peso de um halter só. assistencia: carga que ajuda o movimento, menor é progresso."
                    },
                    "por_lado": {
                      "type": "boolean",
                      "description": "Repetições, tempo ou distância prescritos para cada lado (perna, braço). Não muda a forma de registrar a carga."
                    },
                    "descanso_segundos_min": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "descanso_segundos_max": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rir_alvo_min": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "rir_alvo_max": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "observacoes": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "series": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "repeticoes_min": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "repeticoes_max": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "segundos_min": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "segundos_max": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "metros_min": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "metros_max": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "carga_sugerida": {
                            "type": "number",
                            "minimum": 0
                          },
                          "quedas": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "repeticoes_min": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0
                                },
                                "repeticoes_max": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0
                                },
                                "segundos_min": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0
                                },
                                "segundos_max": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0
                                },
                                "metros_min": {
                                  "type": "number",
                                  "exclusiveMinimum": 0
                                },
                                "metros_max": {
                                  "type": "number",
                                  "exclusiveMinimum": 0
                                },
                                "carga_sugerida": {
                                  "type": "number",
                                  "minimum": 0
                                }
                              },
                              "additionalProperties": false,
                              "description": "Queda de um drop set, feita logo após a série, com a mesma métrica dela. Exatamente uma métrica, com os dois campos do par: repeticoes_min/repeticoes_max, segundos_min/segundos_max ou metros_min/metros_max. Valor fixo repete o número nos dois."
                            },
                            "minItems": 1,
                            "maxItems": 10
                          }
                        },
                        "additionalProperties": false,
                        "description": "Exatamente uma métrica, com os dois campos do par: repeticoes_min/repeticoes_max, segundos_min/segundos_max ou metros_min/metros_max. Valor fixo repete o número nos dois."
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "nome",
                    "forma_carga",
                    "series"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "nome",
              "exercicios"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "versao",
        "nome",
        "unidade_carga",
        "treinos"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
